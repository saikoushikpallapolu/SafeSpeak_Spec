{
  "name": "safespeak-workspace",
  "private": true,
  "version": "1.0.0",
  "main": "server.js",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "node server.js",
    "start:server": "npx tsx apps/server/src/server.ts",
    "dev": "concurrently \"npm --prefix apps/server run dev\" \"npm --prefix apps/web run dev\"",
    "dev:server": "npx tsx apps/server/src/server.ts",
    "dev:web": "npm --prefix apps/web run dev",
    "build:server": "npm --prefix apps/server run build",
    "build:web": "npm --prefix apps/web run build",
    "build": "npm --prefix apps/web run build && npm --prefix apps/server run build",
    "preview": "npm --prefix apps/web run preview"
  },
  "dependencies": {
    "tsx": "^4.15.7"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
